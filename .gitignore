# Container images and temporary build artifacts
*.sif
*.img
container/build/
container/dist/

# Spack-generated installation trees
spack/opt/
spack/var/
*.install.log

# Experiment outputs that may be large or contain scheduler details
results/raw/*.tmp
results/plots/*.tmp
*.pbs.o*
*.pbs.e*

# Local Python tooling
.venv/
__pycache__/
*.py[cod]

# Editors and OS files
.DS_Store
.idea/
.vscode/

# Keep reproducibility artifacts and benchmark logs under version control.
# Do not commit credentials or private cluster configuration.
