#!/usr/bin/env bash
#PBS -N osu-ucx
#PBS -q parexp
#PBS -l select=2:ncpus=48
#PBS -l place=scatter:exclhost
#PBS -j oe
set -euo pipefail
ROOT="${PROJECT_ROOT:?set PROJECT_ROOT}"
MPICH_PREFIX="${MPICH_PREFIX:?set MPICH_PREFIX}"
OSU_PREFIX="${OSU_PREFIX:?set OSU_PREFIX}"
UCX_PREFIX="${UCX_PREFIX:?set UCX_PREFIX}"
RESULT_DIR="${RESULT_DIR:-$ROOT/results/raw/ucx-${PBS_JOBID}}"
mkdir -p "$RESULT_DIR" "$HOME/.ssh"
chmod 700 "$HOME/.ssh"
module load gcc/9.4.0
export PATH="$MPICH_PREFIX/bin:$PATH"
export LD_LIBRARY_PATH="$MPICH_PREFIX/lib:$UCX_PREFIX/lib:${LD_LIBRARY_PATH:-}"
for node in $(sort -u "$PBS_NODEFILE"); do
    ssh-keygen -R "$node" >/dev/null 2>&1 || true
    for ip in $(getent hosts "$node" | cut -d' ' -f1); do ssh-keygen -R "$ip" >/dev/null 2>&1 || true; done
    ssh-keyscan -T 10 -H "$node" >> "$HOME/.ssh/known_hosts" 2>/dev/null
done
ARGS=(-m 1:67108864 -x 100 -i 1000)
for rep in 01 02 03; do
    "$MPICH_PREFIX/bin/mpiexec" -f "$PBS_NODEFILE" -n 2 -ppn 1 "$OSU_PREFIX/libexec/osu-micro-benchmarks/mpi/pt2pt/osu_latency" "${ARGS[@]}" > "$RESULT_DIR/native_latency_rep${rep}.out" 2>&1
    "$MPICH_PREFIX/bin/mpiexec" -f "$PBS_NODEFILE" -n 2 -ppn 1 "$OSU_PREFIX/libexec/osu-micro-benchmarks/mpi/pt2pt/osu_bw" "${ARGS[@]}" > "$RESULT_DIR/native_bw_rep${rep}.out" 2>&1
    "$MPICH_PREFIX/bin/mpiexec" -f "$PBS_NODEFILE" -n 2 -ppn 1 singularity exec --bind /opt/ohpc,/dev/infiniband "$CONTAINER_IMAGE" "$OSU_PREFIX/libexec/osu-micro-benchmarks/mpi/pt2pt/osu_latency" "${ARGS[@]}" > "$RESULT_DIR/container_latency_rep${rep}.out" 2>&1
    "$MPICH_PREFIX/bin/mpiexec" -f "$PBS_NODEFILE" -n 2 -ppn 1 singularity exec --bind /opt/ohpc,/dev/infiniband "$CONTAINER_IMAGE" "$OSU_PREFIX/libexec/osu-micro-benchmarks/mpi/pt2pt/osu_bw" "${ARGS[@]}" > "$RESULT_DIR/container_bw_rep${rep}.out" 2>&1
done
